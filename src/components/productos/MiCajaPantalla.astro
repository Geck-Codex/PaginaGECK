---
/**
 * La pantalla de Venta de Mi Caja, dibujada fiel a la app (rediseño, WPF).
 *
 * Sale del codigo de la app (`micaja/Views/SideBar.xaml` y `VentasPage.xaml`):
 *  - Menu lateral azul #2C4E7A, logo en cuadro blanco, botones de icono y
 *    nombre; la seccion activa va en blanco con texto azul.
 *  - Secciones de la base, en el orden de la app: Venta, Caja, Productos,
 *    Reportes, Clientes. Las secciones de las piezas (Apartados, Vales...) se
 *    meten despues de Venta, igual que en la app.
 *  - Venta: buscador "Escanea, o escribe el codigo o el nombre…", el ticket,
 *    el total y FORMA DE PAGO (Efectivo, Tarjeta, Transf.). Las piezas agregan
 *    su forma de pago: Fiar (fiado), Apartar (apartados), Vale (vales).
 *
 * VISTAS: ademas de Venta trae Caja, Corte, Productos, Reportes y Clientes
 * (la base, con los textos de la app) y las de las piezas: Apartados y Vales
 * (fieles), Mesas, Comandas, Citas, Bascula y una generica (concepto). El
 * script cambia de vista con `mostrar()` y marca su boton del menu.
 *
 * Lo que cambia con las piezas lo pone `src/scripts/mi-caja.js`
 * (`pantalla()`), leyendo `data-menu` y `data-pagos`. Aqui solo va la base y,
 * si se pasan, las piezas iniciales (para que sin JS se vea completa).
 */
interface Props {
  giro: string;
  venta?: string;
  /** Secciones de piezas que ya van puestas: [{ id, k, d }]. */
  menu?: { id: string; k: string; d: string }[];
  /** Formas de pago de piezas que ya van puestas: [{ id, k }]. */
  pagos?: { id: string; k: string }[];
  ticket?: [string, string][];
}

const {
  giro,
  venta = '$167.00',
  menu = [],
  pagos = [],
  ticket = [['2 Coca-Cola 600 ml', '$44.00'], ['1 Sabritas sal 45 g', '$19.00'], ['1 Huevo blanco kg', '$48.00']],
} = Astro.props;

/* Iconos de linea 24×24 que hacen las veces de los glifos Segoe de la app. */
const I = {
  venta: 'M6 6h15l-1.5 8h-12zM6 6 5 3H2M9 19a1 1 0 1 0 0 .01M17 19a1 1 0 1 0 0 .01',
  caja: 'M3 8h18v11H3zM7 8V5h10v3M3 13h18M11 13v2h2v-2',
  productos: 'M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10',
  reportes: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  clientes: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0',
  lector: 'M3 7V5h4M17 5h4v2M21 17v2h-4M7 19H3v-2M7 9v6M10 9v6M13 9v6M16 9v6',
};
const base = [
  { id: 'caja', k: 'Caja', d: I.caja },
  { id: 'productos', k: 'Productos', d: I.productos },
  { id: 'reportes', k: 'Reportes', d: I.reportes },
  { id: 'clientes', k: 'Clientes', d: I.clientes },
];
---

<div class="mc-app" data-app>
  <nav class="mc-app__lado" aria-hidden="true">
    <span class="mc-app__logo"></span>
    <ul class="mc-app__menu" data-menu>
      <li class="mc-app__item is-activo" data-v="venta"><svg viewBox="0 0 24 24"><path d={I.venta} /></svg><span>Venta</span></li>
      {menu.map((m) => (
        <li class="mc-app__item is-pieza" data-m={m.id}><svg viewBox="0 0 24 24"><path d={m.d} /></svg><span>{m.k}</span></li>
      ))}
      {base.map((b) => (
        <li class="mc-app__item" data-base={b.id} data-v={b.id}><svg viewBox="0 0 24 24"><path d={b.d} /></svg><span>{b.k}</span></li>
      ))}
    </ul>
  </nav>
  <div class="mc-app__main" aria-hidden="true">
    <p class="mc-app__top">
      <span class="mc-app__titulo" data-titulo>Venta</span>
      <span class="mc-app__giro" data-nombre>· {giro}</span>
    </p>
    <div class="mc-app__vistas">
      <!-- Venta -->
      <div class="mc-app__vista is-activa" data-vista="venta">
        <div class="mc-app__buscar"><svg viewBox="0 0 24 24"><path d={I.lector} /></svg><span>Escanea, o escribe el código o el nombre…</span></div>
        <div class="mc-app__ticket">
          <p class="mc-app__k">Ticket</p>
          <div class="mc-app__renglones" data-ticket>
            {ticket.map(([q, p]) => <p class="mc-app__renglon"><span>{q}</span><span>{p}</span></p>)}
          </div>
          <p class="mc-app__total"><span>Total</span><b data-venta>{venta}</b></p>
        </div>
        <div class="mc-app__pago">
          <p class="mc-app__k">Forma de pago</p>
          <ul class="mc-app__pagos" data-pagos>
            <li class="is-activo">Efectivo</li><li>Tarjeta</li><li>Transf.</li>
            {pagos.map((p) => <li class="is-pieza" data-p={p.id}>{p.k}</li>)}
          </ul>
        </div>
      </div>

      <!-- Caja -->
      <div class="mc-app__vista" data-vista="caja">
        <div class="mc-v-card mc-v-estado"><span class="mc-v-punto"></span><b>CAJA ABIERTA</b><span>Turno en curso</span></div>
        <div class="mc-v-dos">
          <div class="mc-v-card"><p class="mc-app__k">Ventas hoy</p><p class="mc-v-big">$3,480.00</p></div>
          <div class="mc-v-card"><p class="mc-app__k">En caja</p><p class="mc-v-big mc-v-big--verde">$2,150.00</p><p class="mc-v-sub">efectivo esperado</p></div>
        </div>
        <div class="mc-v-card"><p class="mc-app__renglon"><span>Fondo inicial</span><span>$500.00</span></p></div>
        <ul class="mc-app__pagos"><li>Ingreso</li><li>Retiro</li><li class="is-activo">Cerrar Caja</li></ul>
      </div>

      <!-- Corte (vive en Caja) -->
      <div class="mc-app__vista" data-vista="corte">
        <div class="mc-v-card">
          <p class="mc-app__k">Corte de caja</p>
          <p class="mc-app__renglon"><span>Fondo inicial</span><span>$500.00</span></p>
          <p class="mc-app__renglon"><span>Ventas en efectivo</span><span>$1,850.00</span></p>
          <p class="mc-app__renglon"><span>Ingresos manuales</span><span>$0.00</span></p>
          <p class="mc-app__renglon"><span>Retiros manuales</span><span>-$200.00</span></p>
          <p class="mc-app__total"><span>Debe haber</span><b>$2,150.00</b></p>
          <p class="mc-app__renglon"><span>Contaste</span><span>$2,100.00</span></p>
          <p class="mc-app__renglon mc-v-falta"><span>Faltan</span><span>-$50.00</span></p>
        </div>
      </div>

      <!-- Productos -->
      <div class="mc-app__vista" data-vista="productos">
        <div class="mc-app__buscar"><svg viewBox="0 0 24 24"><path d={I.lector} /></svg><span>Buscar por nombre o código...</span></div>
        <ul class="mc-app__pagos"><li>Todos</li><li>Favoritos</li><li class="is-activo">Poco stock</li></ul>
        <div class="mc-v-card mc-v-tabla">
          <p class="mc-v-th"><span>Producto</span><span>Precio</span><span>Existencia</span></p>
          <p><span>Coca-Cola 600 ml</span><span>$22.00</span><span class="mc-v-rojo">3 · poco stock</span></p>
          <p><span>Huevo blanco kg</span><span>$48.00</span><span class="mc-v-rojo">2 · poco stock</span></p>
          <p><span>Sabritas sal 45 g</span><span>$19.00</span><span class="mc-v-rojo">4 · poco stock</span></p>
        </div>
      </div>

      <!-- Reportes -->
      <div class="mc-app__vista" data-vista="reportes">
        <ul class="mc-app__pagos"><li class="is-activo">Resumen</li><li>Cortes</li><li>Utilidad</li></ul>
        <div class="mc-v-dos">
          <div class="mc-v-card"><p class="mc-app__k">Vendido</p><p class="mc-v-big">$18,240.00</p></div>
          <div class="mc-v-card"><p class="mc-app__k">Te dejó</p><p class="mc-v-big mc-v-big--verde">$4,560.00</p><p class="mc-v-sub">utilidad estimada</p></div>
        </div>
        <div class="mc-v-card">
          <p class="mc-app__k">Ventas por día</p>
          <div class="mc-v-barras">{[52, 68, 45, 74, 88, 100, 61].map((h, i) => <i style={`--h:${h}%`}><em>{['L', 'M', 'M', 'J', 'V', 'S', 'D'][i]}</em></i>)}</div>
        </div>
      </div>

      <!-- Clientes (el fiado se ve aqui) -->
      <div class="mc-app__vista" data-vista="clientes">
        <div class="mc-app__buscar"><svg viewBox="0 0 24 24"><path d={I.clientes} /></svg><span>Buscar cliente por nombre o teléfono...</span></div>
        <div class="mc-v-card mc-v-tabla">
          <p class="mc-v-th"><span>Cliente</span><span>Debe</span><span>Puede fiar</span></p>
          <p><span>Doña Mary</span><span class="mc-v-rojo">$340.00</span><span>$160.00</span></p>
          <p><span>Don Beto</span><span class="mc-v-rojo">$85.50</span><span>$414.50</span></p>
          <p><span>Chuy</span><span>$0.00</span><span>$500.00</span></p>
        </div>
        <ul class="mc-app__pagos"><li class="is-activo">Registrar pago</li></ul>
      </div>

      <!-- Apartados -->
      <div class="mc-app__vista" data-vista="apartados">
        <div class="mc-v-dos">
          <div class="mc-v-card"><p class="mc-app__k">Registrados</p><p class="mc-v-big">4</p></div>
          <div class="mc-v-card"><p class="mc-app__k">El más antiguo</p><p class="mc-v-big mc-v-rojo">12 días</p></div>
        </div>
        <div class="mc-app__buscar"><svg viewBox="0 0 24 24"><path d={I.clientes} /></svg><span>Buscar por nombre o prenda...</span></div>
        <div class="mc-v-card mc-v-tabla mc-v-tabla--2">
          <p><span>Blusa beige · Karla</span><span>Hace 3 días</span></p>
          <p><span>Vestido negro · Ana</span><span>Hoy</span></p>
          <p><span>Botas café · Lupita</span><span class="mc-v-rojo">Hace 12 días</span></p>
        </div>
      </div>

      <!-- Vales -->
      <div class="mc-app__vista" data-vista="vales">
        <div class="mc-v-card"><p class="mc-app__k">Vales vigentes</p><p class="mc-v-big">$730.00</p></div>
        <div class="mc-v-card mc-v-tabla mc-v-tabla--2">
          <p><span>Vale de Sofía · cambio de talla</span><span>$450.00</span></p>
          <p><span>Vale de Mariana · blusa</span><span>$280.00</span></p>
        </div>
        <ul class="mc-app__pagos"><li class="is-activo">Cobrar con vale</li></ul>
      </div>

      <!-- Mesas -->
      <div class="mc-app__vista" data-vista="mesas">
        <div class="mc-v-mesas">
          {[['1', ''], ['2', '$230'], ['3', ''], ['4', '$415'], ['5', '$95'], ['6', '']].map(([n, t]) => (
            <div class={t ? 'is-ocupada' : ''}><b>Mesa {n}</b><span>{t || 'Libre'}</span></div>
          ))}
        </div>
      </div>

      <!-- Comandas -->
      <div class="mc-app__vista" data-vista="comandas">
        <div class="mc-v-dos">
          <div class="mc-v-card mc-v-comanda"><p class="mc-app__k">Mesa 2 · En cocina</p><p>2 Enchiladas verdes</p><p>1 Agua de horchata</p></div>
          <div class="mc-v-card mc-v-comanda"><p class="mc-app__k">Para llevar · Lista</p><p>3 Tacos de asada</p><p>1 Refresco</p></div>
        </div>
      </div>

      <!-- Citas -->
      <div class="mc-app__vista" data-vista="citas">
        <div class="mc-v-card mc-v-tabla mc-v-tabla--2">
          <p><span>10:00 · Corte · Lupe</span><span>Confirmada</span></p>
          <p><span>11:30 · Tinte · Karla</span><span>Confirmada</span></p>
          <p><span>13:00</span><span class="mc-v-tenue">Libre</span></p>
          <p><span>16:00 · Uñas · Ana</span><span>Por confirmar</span></p>
        </div>
      </div>

      <!-- Bascula / granel -->
      <div class="mc-app__vista" data-vista="bascula">
        <div class="mc-v-card mc-v-peso"><p class="mc-app__k">Báscula</p><p class="mc-v-kg">1.250 kg</p><p class="mc-v-sub">× $160.00 el kilo</p></div>
        <div class="mc-v-card"><p class="mc-app__total"><span>Al ticket</span><b>$200.00</b></p></div>
      </div>

      <!-- Tallas -->
      <div class="mc-app__vista" data-vista="tallas">
        <div class="mc-v-card mc-v-tabla mc-v-tallas">
          <p class="mc-v-th"><span>Prenda</span><span>Ch</span><span>M</span><span>G</span></p>
          <p><span>Blusa beige</span><span>4</span><span class="mc-v-rojo">1</span><span>3</span></p>
          <p><span>Jeans corte recto</span><span>2</span><span>5</span><span>2</span></p>
          <p><span>Vestido negro</span><span class="mc-v-rojo">0</span><span>2</span><span>1</span></p>
        </div>
        <ul class="mc-app__pagos"><li>Ch</li><li class="is-activo">M</li><li>G</li><li>XG</li></ul>
      </div>

      <!-- Caducidades -->
      <div class="mc-app__vista" data-vista="caducidades">
        <div class="mc-v-card mc-v-tabla mc-v-tabla--2">
          <p class="mc-v-th"><span>Producto · lote</span><span>Caduca</span></p>
          <p><span>Yogurt natural 1 kg</span><span class="mc-v-rojo">En 2 días</span></p>
          <p><span>Paracetamol 500 mg · L23</span><span class="mc-v-rojo">En 9 días</span></p>
          <p><span>Leche entera 1 L</span><span>En 3 semanas</span></p>
          <p><span>Suero oral</span><span>En 4 meses</span></p>
        </div>
      </div>

      <!-- Cotizaciones -->
      <div class="mc-app__vista" data-vista="cotizaciones">
        <div class="mc-v-card mc-v-tabla mc-v-tabla--3">
          <p class="mc-v-th"><span>Cliente</span><span>Total</span><span>Estado</span></p>
          <p><span>Constructora Ruiz</span><span>$8,450.00</span><span>Enviada</span></p>
          <p><span>Don Chava · baño</span><span>$2,120.00</span><span class="mc-v-verde">Aceptada</span></p>
          <p><span>Escuela Morelos</span><span>$5,300.00</span><span class="mc-v-tenue">Vence mañana</span></p>
        </div>
        <ul class="mc-app__pagos"><li class="is-activo">Nueva cotización</li><li>Convertir en venta</li></ul>
      </div>

      <!-- Mayoreo / pieza o paquete -->
      <div class="mc-app__vista" data-vista="mayoreo">
        <div class="mc-v-card mc-v-tabla mc-v-tabla--3">
          <p class="mc-v-th"><span>Producto</span><span>Menudeo</span><span>Mayoreo</span></p>
          <p><span>Coca-Cola 600 ml</span><span>$22.00</span><span class="mc-v-verde">$19.50 · 12+</span></p>
          <p><span>Cemento 50 kg</span><span>$265.00</span><span class="mc-v-verde">$245.00 · 10+</span></p>
          <p><span>Cuaderno profesional</span><span>$45.00</span><span class="mc-v-verde">$38.00 · caja</span></p>
        </div>
        <div class="mc-v-card"><p class="mc-app__renglon"><span>Se aplica solo al llegar a la cantidad</span><span>✓</span></p></div>
      </div>

      <!-- Por metro -->
      <div class="mc-app__vista" data-vista="metro">
        <div class="mc-v-card mc-v-peso"><p class="mc-app__k">Cable calibre 12</p><p class="mc-v-kg">3.50 m</p><p class="mc-v-sub">× $14.00 el metro</p></div>
        <div class="mc-v-card"><p class="mc-app__total"><span>Al ticket</span><b>$49.00</b></p></div>
      </div>

      <!-- Copias -->
      <div class="mc-app__vista" data-vista="copias">
        <div class="mc-v-dos">
          <div class="mc-v-card mc-v-peso"><p class="mc-app__k">Blanco y negro</p><p class="mc-v-kg">20</p><p class="mc-v-sub">× $1.00</p></div>
          <div class="mc-v-card mc-v-peso"><p class="mc-app__k">Color</p><p class="mc-v-kg">4</p><p class="mc-v-sub">× $5.00</p></div>
        </div>
        <div class="mc-v-card"><p class="mc-app__total"><span>Al ticket</span><b>$40.00</b></p></div>
      </div>

      <!-- Listas escolares -->
      <div class="mc-app__vista" data-vista="listas">
        <div class="mc-v-card mc-v-tabla mc-v-tabla--2 mc-v-lista">
          <p class="mc-v-th"><span>3° de primaria · Esc. Morelos</span><span>5 de 6</span></p>
          <p><span>✓ 4 cuadernos profesionales</span><span>$180.00</span></p>
          <p><span>✓ Juego de geometría</span><span>$45.00</span></p>
          <p><span>✓ Colores 24 pz</span><span>$65.00</span></p>
          <p><span class="mc-v-rojo">○ Diccionario escolar</span><span class="mc-v-rojo">No hay</span></p>
        </div>
      </div>

      <!-- Cortes (carniceria) -->
      <div class="mc-app__vista" data-vista="cortes">
        <div class="mc-v-card mc-v-tabla mc-v-tabla--3">
          <p class="mc-v-th"><span>Corte</span><span>Precio kg</span><span>Hay</span></p>
          <p><span>Bistec de res</span><span>$190.00</span><span>8.5 kg</span></p>
          <p><span>Arrachera</span><span>$320.00</span><span class="mc-v-rojo">1.2 kg</span></p>
          <p><span>Molida especial</span><span>$165.00</span><span>6.0 kg</span></p>
        </div>
        <ul class="mc-app__pagos"><li class="is-activo">Pesar en báscula</li></ul>
      </div>

      <!-- Con receta (farmacia) -->
      <div class="mc-app__vista" data-vista="receta">
        <div class="mc-v-card">
          <p class="mc-app__k">Venta con receta</p>
          <p class="mc-app__renglon"><span>Amoxicilina 500 mg</span><span>$118.00</span></p>
          <p class="mc-app__renglon"><span>Médico</span><span>Dra. Herrera</span></p>
          <p class="mc-app__renglon"><span>Cédula</span><span>4581236</span></p>
          <p class="mc-app__renglon"><span>Receta</span><span class="mc-v-verde">Capturada ✓</span></p>
        </div>
      </div>

      <!-- Comisiones (estetica) -->
      <div class="mc-app__vista" data-vista="comision">
        <div class="mc-v-card mc-v-tabla mc-v-tabla--3">
          <p class="mc-v-th"><span>Estilista</span><span>Servicios</span><span>Comisión</span></p>
          <p><span>Lupe</span><span>9</span><span class="mc-v-verde">$810.00</span></p>
          <p><span>Karla</span><span>6</span><span class="mc-v-verde">$540.00</span></p>
          <p><span>Ana</span><span>4</span><span class="mc-v-verde">$360.00</span></p>
        </div>
      </div>

      <!-- Cualquier otra pieza: se arma para el negocio -->
      <div class="mc-app__vista" data-vista="generica">
        <div class="mc-v-card mc-v-armando">
          <p class="mc-app__k" data-generica>Tu pieza</p>
          <i style="--w:82%"></i><i style="--w:64%"></i><i style="--w:74%"></i>
          <p class="mc-v-sub">Esta pieza se arma a la medida de tu negocio.</p>
        </div>
      </div>
    </div>
  </div>
  <p class="mc-app__tag">La base</p>
</div>

<style is:global>
  /* Global a proposito: el script mete secciones y formas de pago nuevas, y un
     elemento creado por JS no lleva el atributo de estilos encapsulados. */
  .mc-app {
    position: relative; display: grid; grid-template-columns: 66px 1fr;
    background: #EFECE6; border: 1px solid #E2DBD0; border-radius: 18px;
    box-shadow: 0 1px 0 #fff inset, 0 24px 50px -18px rgb(42 37 32 / 0.3);
    font-family: var(--pr-font);
  }
  .mc-app__lado {
    /* height 0 + min-height 100%: la altura la manda la pantalla, no el menu.
       Con muchas piezas el menu se desplaza por dentro, como en la app. */
    position: relative; height: 0; min-height: 100%; overflow: hidden;
    background: #2C4E7A; border-radius: 17px 0 0 17px;
    display: flex; flex-direction: column; align-items: center; padding: 10px 0 0;
  }
  .mc-app__lado::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 26px; pointer-events: none;
    background: linear-gradient(transparent, #2C4E7A); border-radius: 0 0 0 17px;
  }
  .mc-app__logo {
    width: 30px; height: 30px; border-radius: 8px; margin-bottom: 8px;
    background: #fff url('/assets/image/micaja/marca.webp') center / 22px no-repeat;
  }
  .mc-app__menu { position: relative; list-style: none; margin: 0; padding: 0 6px 18px; width: 100%; display: flex; flex-direction: column; gap: 2px; flex: 1 1 0; min-height: 0; overflow: hidden; }
  .mc-app__item {
    flex: none; display: grid; justify-items: center; gap: 2px; padding: 5px 2px; border-radius: 9px;
    color: #fff; overflow: hidden;
  }
  .mc-app__item svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .mc-app__item span { font-size: 9px; font-weight: 600; line-height: 1.1; white-space: nowrap; }
  .mc-app__item.is-activo { background: #fff; color: #2C4E7A; }
  .mc-app__item.is-pieza { background: rgb(255 255 255 / 0.16); box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.5); transition: background-color 0.5s, color 0.5s; }
  .mc-app__item.is-nuevo { background: #fff; color: #2C4E7A; }
